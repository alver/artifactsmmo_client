{
  "name": "artifactsmmo-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local ArtifactsMMO client: a Node service runs the game (queues, hive, every API call) and serves the browser UI as a view. Sync once, track state from action responses, no polling.",
  "scripts": {
    "dev": "node scripts/serve.mjs --watch",
    "start": "vite build && node scripts/serve.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "assets": "bash scripts/download-assets.sh"
  },
  "dependencies": {
    "@preact/signals": "^1.3.2",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}

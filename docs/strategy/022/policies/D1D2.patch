+/** Task 022 (scratch, config.gates): rule 3 sees every gate of the lane — per gate g the bundle of the achievements behind the
+ *  gates up to g, scored as bundleScore does (Σ points that fit ÷ (hours to g + their hours)); the best g (by fit, then by
+ *  points per hour, then the nearest) is the bundle. The road is walked once to the farthest gate, at the pace of the last
+ *  level before a wall past it (as for the nearest gate); hoursToLevel and the combat road's pace (cost.ts roadRate) are
+ *  memoised per World, so the farther gates cost no solve that the nearest did not. */
+function bestGate(lane: Lane, name: string, world: World, c: Ctx, L: number, behind: { code: string; at: number; points: number; ev?: { h: number; cal: number; note?: Bundle["events"][number] } }[]): Bundle {
+  const calH = Math.max(0, (Date.parse(world.config.deadline) - world.now) / 3.6e6);
+  const gates = [...new Set(behind.map((b) => b.at))].sort((a, b) => a - b);
+  const top = gates[gates.length - 1];
+  const per: number[] = []; // hours of level l → l+1, from L; a wall stops the walk
+  let wall: number | undefined;
+  for (let l = L; l < top; l++) {
+    const h = hoursToLevel(lane, l, l + 1, world, c.ch);
+    if (!Number.isFinite(h)) { wall = l; break; }
+    per.push(h);
+  }
+  let best: { b: Bundle; fit: number; any: number } | undefined;
+  for (const g of gates) {
+    let hGate = 0;
+    for (let l = L; l < g && l - L < per.length; l++) hGate += per[l - L];
+    const w = wall != null && wall < g ? wall : undefined;
+    if (w === L) hGate = Infinity;
+    else if (w != null) hGate += (g - w) * per[per.length - 1];
+    const bundle = behind.filter((x) => x.at <= g);
+    const hs = bundle.map((x) => x.ev?.h ?? achHours(x.code, name, world));
+    const b: Bundle = { lane, next: g, behind: bundle.map(({ code, points }) => ({ code, points })), hGate, wall: w, hs, cal: bundle.map((x, i) => x.ev?.cal ?? hs[i]), events: bundle.flatMap((x) => (x.ev?.note ? [x.ev.note] : [])) };
+    const s = bundleScore(b, hGate, calH);
+    if (!best || s.fit > best.fit || (s.fit === best.fit && s.any > best.any)) best = { b, fit: s.fit, any: s.any };
+  }
+  return best!.b;
+}

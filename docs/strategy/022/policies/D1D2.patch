+/** Task 022 (scratch, config.fleetGear, D2): (a) judged for the fleet. Per fighter, as (a) does: H0 on its next ten levels,
+ *  the pick and the flips, each solved with every candidate (the same solve as (a)'s first, so the same key); the monster
+ *  whose set costs least (its own G + H1). Then per group of fighters whose sets share a piece: one G for the union of their
+ *  pieces (each wearer's copies; a crafter's level road once — makeHours takes the highest level per crafter), and the need
+ *  holds when G + sum H1 <= NEED_RATIO x sum H0. Not holding: the dearest piece of the union goes and every member solves again
+ *  without it, at most DROPS times; the cheapest union that holds is kept (as fightNeed keeps the cheapest set). Each member
+ *  gets its own need, its pieces, the fleet's G, and a score with its share of G (G / the members). */
+interface Road { ch: Character; b: NonNullable<ReturnType<typeof bundleOf>>; L: number; end: number; H0: number; rest: number; unpaced: number; cands: string[]; monster: string; h1: (r: GearRecommendation) => number; pieces: Map<string, number>; H1: number }
+function fleetRoad(ch: Character, world: World, b: NonNullable<ReturnType<typeof bundleOf>>, cands: string[]): Road | undefined {
+  const L = ch.level, end = Math.min(b.next, L + 10);
+  const xpNeeded = atlas()?.xpNeeded ?? [];
+  const own = (l: number): number => levelHoursEstimate("combat", l, world, ch);
+  let H0 = 0, rest = 0, pace = Infinity, unpaced = 0;
+  for (let l = L; l < b.next; l++) {
+    const h = own(l);
+    if (Number.isFinite(h)) pace = h;
+    if (l < end) H0 += h;
+    else if (Number.isFinite(pace)) rest += Number.isFinite(h) ? h : pace;
+    else unpaced++;
+  }
+  const cur = pickMonster(ch, world, new Set());
+  const ok = (code: string): boolean => { const m = monsterOf(code); return !!m && m.type !== "boss" && m.type !== "raid_boss" && fightXp(m.level, m.hp, m.type, L) > 0 && !!nearestSpot(placeOf(ch), "monster", code, world); };
+  const flips = [...catalog().monsters.values()].filter((m) => m.level <= L + 2 && ok(m.code) && !safeWin(ch, world, m.code))
+    .sort((x, y) => fightXp(y.level, y.hp, y.type, L) - fightXp(x.level, x.hp, x.type, L) || (x.code < y.code ? -1 : 1)).slice(0, cur ? FLIPS : Infinity).map((m) => m.code);
+  let best: Road | undefined, bestCost = Infinity;
+  for (const m of [...new Set([cur?.monster ?? "", ...flips])].filter(Boolean)) {
+    const mon = monsterOf(m)!;
+    const h1 = (r: GearRecommendation): number => {
+      if (!wins(r, world)) return Infinity;
+      const sec = killSec(ch, world, m, r), wis = setWisdom(ch, r);
+      let h = 0;
+      for (let l = L; l < end; l++) { const xp = fightXp(mon.level, mon.hp, mon.type, l, wis); h += Math.min(own(l), xp > 0 ? (xpNeeded[l] ?? Infinity) / ((xp / sec) * 3600) : Infinity); }
+      return h;
+    };
+    const r = solve(ch, world, m, cands);
+    if (!r || !wins(r, world)) continue;
+    const pieces = newPieces(r, ch, world);
+    if (!pieces.size) continue;
+    const H1 = h1(r), cost = makeHours(pieces, ch, world).G + H1;
+    if (cost < bestCost) { bestCost = cost; best = { ch, b, L, end, H0, rest, unpaced, cands, monster: m, h1, pieces, H1 }; }
+  }
+  return best;
+}
+function fleetNeeds(roads: Road[], world: World, calH: number): Need[] {
+  const out: Need[] = [];
+  // groups: fighters whose sets share a piece (union-find on the piece codes)
+  const parent = roads.map((_, i) => i);
+  const find = (i: number): number => (parent[i] === i ? i : (parent[i] = find(parent[i])));
+  for (let i = 0; i < roads.length; i++) for (let j = 0; j < i; j++) if ([...roads[i].pieces.keys()].some((c) => roads[j].pieces.has(c))) parent[find(i)] = find(j);
+  const groups = new Map<number, Road[]>();
+  roads.forEach((r, i) => groups.set(find(i), [...(groups.get(find(i)) ?? []), r]));
+  for (const members of groups.values()) {
+    let sets = members.map((r) => ({ r, pieces: r.pieces, H1: r.H1 }));
+    let kept: { sets: typeof sets; mk: ReturnType<typeof makeHours> } | undefined;
+    const dropped = new Set<string>();
+    for (let d = 0; d <= DROPS; d++) {
+      const wearing = sets.filter((s) => s.pieces.size);
+      if (!wearing.length) break;
+      const union = new Map<string, number>();
+      for (const s of wearing) for (const [c, n] of s.pieces) union.set(c, (union.get(c) ?? 0) + n);
+      const mk = makeHours(union, wearing[0].r.ch, world);
+      const H1 = wearing.reduce((t, s) => t + s.H1, 0), H0 = wearing.reduce((t, s) => t + s.r.H0, 0);
+      if (mk.G + H1 <= NEED_RATIO * H0) kept = { sets: wearing, mk };
+      else if (kept) break;
+      const dear = [...union.keys()].map((c) => ({ c, g: makeHours(new Map([[c, 1]]), wearing[0].r.ch, world).G })).sort((a, b) => b.g - a.g || (a.c < b.c ? -1 : 1))[0].c;
+      dropped.add(dear);
+      sets = sets.map((s) => {
+        if (!s.pieces.has(dear)) return s;
+        const r = solve(s.r.ch, world, s.r.monster, s.r.cands.filter((c) => !dropped.has(c)));
+        if (!r || !wins(r, world)) return { r: s.r, pieces: new Map<string, number>(), H1: s.r.H0 };
+        return { r: s.r, pieces: newPieces(r, s.r.ch, world), H1: s.r.h1(r) };
+      });
+    }
+    if (!kept) continue;
+    const n = kept.sets.length;
+    for (const s of kept.sets) {
+      const r = s.r, share = kept.mk.G / n;
+      const sc = bundleScore(r.b, share + s.H1 + r.rest + (r.unpaced * s.H1) / Math.max(1, r.end - r.L), calH);
+      out.push({ for: r.ch.name, work: `combat ${r.L} -> ${r.end}${r.end < r.b.next ? ` (of ${r.b.next})` : ""} (the fleet's: ${n} wearers)`, key: `lvl:combat:${r.b.next}`, monster: r.monster, pieces: s.pieces, H0: r.H0, H1: s.H1, G: kept.mk.G, parts: kept.mk.parts, points: sc.points, fit: sc.fit, any: sc.any, hours: sc.hours, offered: kept.mk.offered });
+    }
+  }
+  return out;
+}

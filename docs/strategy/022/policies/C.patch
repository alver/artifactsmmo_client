diff --git a/src/plan/planner/tier.ts b/src/plan/planner/tier.ts
new file mode 100644
index 0000000..6625307
--- /dev/null
+++ b/src/plan/planner/tier.ts
@@ -0,0 +1,62 @@
+// Task 022 (scratch): the strategy experiment's first tier — what rank() puts where config.first ranks (decide.ts), among
+// themselves by today's scores. Every key is off by default; off, nothing here is called. Pure.
+//   config.spine N    — while a character's combat is below N, what serves its combat road: its combat level step, the
+//                       gear pieces and the consumables whose need's work is that road (gear.ts (a), consumables.ts (a))
+//                       and every link of their supply (a supply leaf any of whose parents is such a need, a level of a
+//                       lane gated in such a chain, the crafter's level for such a piece). For all five.
+//   config.crafters N — the three gear-crafting role holders take their skill to N (one level of `train` at a time; the
+//                       train step sources its own materials, so their supply rides inside it).
+//   both              — the crafters' floor first for the three, the spine for all five (CS).
+//   config.calKeep H  — a level road behind which an event achievement sits joins the first tier while its calendar's
+//                       slack (the deadline less the road and the calendar) is under H hours: a calendar is never sold for
+//                       a level. 72 when spine or crafters is on and calKeep is not given; 0 = off.
+
+import { GEAR_CRAFT } from "./config";
+import { consumableNeeds } from "./consumables";
+import { levelOf } from "./cost";
+import { gearNeeds } from "./gear";
+import { crafterOf } from "./roles";
+import type { Bundle } from "./bundle";
+import type { Lane, World } from "./types";
+
+export interface Tier {
+  spine: number; crafters: number; calKeep: number;
+  /** the gear pieces and consumable needs (parent keys) that serve the road of a character below the spine */
+  spineParents: Set<string>;
+  spinePieces: Set<string>;
+  /** the gear-crafting lanes this character holds below the floor */
+  floorLanes: Lane[];
+  /** target key → why it is first tier ("spine", "floor", "cal") */
+  tags: Map<string, string>;
+}
+
+export function tierOf(world: World, name: string): Tier | undefined {
+  const cfg = world.config;
+  const spine = cfg.spine ?? 0, crafters = cfg.crafters ?? 0;
+  if (!spine && !crafters) return undefined;
+  const calKeep = cfg.calKeep ?? 72;
+  const ch = world.characters.find((c) => c.name === name)!;
+  const below = (who: string): boolean => (world.characters.find((c) => c.name === who)?.level ?? Infinity) < spine;
+  const spineParents = new Set<string>(), spinePieces = new Set<string>();
+  if (spine) {
+    for (const n of gearNeeds(world, name).needs) if (n.offered && n.key.startsWith("lvl:combat:") && below(n.for)) for (const code of n.pieces.keys()) { spinePieces.add(code); spineParents.add(`gear:${code}`); }
+    for (const n of consumableNeeds(world, name)) { const m = /^lvl:combat:\d+@(.+)$/.exec(n.workKey); if (m && below(m[1])) spineParents.add(n.key); }
+  }
+  const floorLanes = crafters ? GEAR_CRAFT.filter((l) => crafterOf(l, world) === name && levelOf(ch, l) < crafters) : [];
+  return { spine, crafters, calKeep, spineParents, spinePieces, floorLanes, tags: new Map() };
+}
+
+/** Whether a bundle's calendar is about to stop fitting: an event achievement behind it whose slack is in [0, calKeep). */
+export function calTight(b: Bundle, calH: number, calKeep: number): boolean {
+  if (!calKeep || !b.events.length) return false;
+  const ev = new Set(b.events.map((e) => e.code));
+  return b.behind.some((x, i) => ev.has(x.code) && calH - b.hGate - b.cal[i] >= 0 && calH - b.hGate - b.cal[i] < calKeep);
+}
+
+/** The first tier of rank(): `tag` of a candidate's target key; CS — a crafter below its floor takes its floor (and a tight
+ *  calendar) alone. */
+export function firstOf<C extends { target: { key: string } }>(tier: Tier, real: C[]): C[] {
+  const floor = real.filter((c) => tier.tags.get(c.target.key) === "floor" || tier.tags.get(c.target.key) === "cal");
+  if (tier.floorLanes.length && floor.some((c) => tier.tags.get(c.target.key) === "floor")) return floor;
+  return real.filter((c) => tier.tags.has(c.target.key) && tier.tags.get(c.target.key) !== "floor");
+}

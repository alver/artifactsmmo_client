+/** Task 022 (scratch, config.home): every transition open — the bank a tolled trip comes home to (the toll's round trip
+ *  starts and ends at the bank nearest its place, never the island's conditional bank). */
+const ALL_OPEN: May = () => true;
+mayKeys.set(ALL_OPEN, "all");
+export const homeBankOf = (p: Place): Place | undefined => nearestBankOf(p, ALL_OPEN).place;
